    <string name="settings_search_searxng_hint">Uses your own SearXNG instance (URL under Advanced). JSON output must be enabled in settings.yml.</string>
    <string name="settings_search_groq_hint">Uses Groq\'s built-in browser search with your LLM key. Slower and uses ~8k tokens per search (free-tier limits apply).</string>
